# Server port and database
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/trustvault
# Address of the website (used in email links). Use http://localhost:5000 after "npm run build".
APP_URL=http://localhost:5173

# Secret keys - filled automatically by "npm run setup". Never share or commit them.
JWT_SECRET=
VAULT_KEY=

# Email (Gmail). Leave SMTP_USER empty for dev mode: emails are saved in server/dev-mail/
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Hosting (see DEPLOY.md). Leave empty on your own computer.
# BREVO_API_KEY + MAIL_FROM send email over HTTPS, FILE_STORE=db keeps files in MongoDB, TRUST_PROXY=1 behind a host's proxy.
BREVO_API_KEY=
MAIL_FROM=
FILE_STORE=
TRUST_PROXY=

# Secret sign-up codes for Faculty and Administrator accounts - filled in by "npm run setup".
FACULTY_CODE=
ADMIN_CODE=

# Google Authenticator session length in minutes
SESSION_MINUTES=60

# Laptop demo only: the made-up @trustvault.demo accounts skip the email code (needs APP_URL on localhost).
# DEMO_SKIP_EMAIL=1
